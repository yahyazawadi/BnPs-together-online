<Window x:Class="BnPRelay.RestoreSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Save" Width="420" Height="300"
        Background="#000000" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="* Choose a timeline to restore:"
                   Style="{StaticResource PixelText}" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" x:Name="ListBackups"
                 Background="#000000" BorderBrush="#FFFFFF" BorderThickness="2"
                 Foreground="#FFFFFF">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Text="♥ " Foreground="#FF3040"
                                   FontFamily="{StaticResource DeterminationFont}"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding FriendlyLabel}"
                                   FontFamily="{StaticResource DeterminationFont}"
                                   FontSize="13" Foreground="#FFFFFF"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="#000000"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="[ RESTORE ]" Style="{StaticResource PixelButton}"
                    Click="BtnRestore_Click"/>
            <Button Grid.Column="2" Content="[ BACK ]" Style="{StaticResource PixelButton}"
                    Click="BtnBack_Click"/>
        </Grid>
    </Grid>
</Window>
