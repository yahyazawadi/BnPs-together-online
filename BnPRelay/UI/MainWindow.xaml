<Window x:Class="BnPRelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BnP Together ONLINE"
        Icon="pack://application:,,,/UI/Assets/heart.ico"
        Width="480" Height="400"
        MinWidth="460" MinHeight="320"
        ResizeMode="CanResizeWithGrip"
        Background="#000000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="16">
        <!-- TITLE -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Dual Overlapping Souls (Red P1 + Cyan P2) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
            <Grid Width="32" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                <!-- Cyan Soul (P2 - pure #01FAFF) -->
                <Image Source="/UI/Assets/heart_cyan.png" Width="18" Height="18"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <!-- Red Soul (P1 - front/left) -->
                <Image Source="/UI/Assets/heart_red.png" Width="18" Height="18"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Grid>
            <TextBlock Text="BnP Together ONLINE"
                       Style="{StaticResource PixelTextLarge}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main content panel: swapped between Connect, Hosting, Connected -->
        <Border Grid.Row="1" Style="{StaticResource PixelBorder}">
            <Grid>
                <!-- === CONNECT SCREEN (default) === -->
                <StackPanel x:Name="PanelConnect" Visibility="Visible">
                    <TextBlock Text="* Choose your role:"
                               Style="{StaticResource PixelText}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnHost" Content="HOST GAME"
                                Style="{StaticResource PixelButton}"
                                Click="BtnHost_Click"/>
                        <Button Grid.Column="2" x:Name="BtnJoin" Content="JOIN GAME"
                                Style="{StaticResource PixelButton}"
                                Click="BtnJoin_Click"/>
                    </Grid>

                    <Button Content="[?] JOIN ZEROTIER NETWORK..."
                            Style="{StaticResource PixelButton}"
                            Margin="0,8,0,0"
                            Click="BtnJoinZeroTier_Click"/>

                    <Button x:Name="BtnCheckUpdate"
                            Content="[↓] UPDATE TO LATEST VERSION"
                            Style="{StaticResource PixelButton}"
                            Margin="0,6,0,0"
                            Click="BtnCheckUpdate_Click"/>

                    <!-- Join IP input (hidden until JOIN clicked) -->
                    <StackPanel x:Name="PanelJoinInput" Visibility="Collapsed" Margin="0,6,0,0">
                        <TextBlock Text="* Enter host IP:" Style="{StaticResource PixelText}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="TxtHostIp"
                                         Style="{StaticResource PixelTextBox}"
                                         TextChanged="TxtHostIp_TextChanged"/>
                                <TextBlock x:Name="TxtIpPlaceholder"
                                           Text="10.147.17.x" IsHitTestVisible="False"
                                           Foreground="#585858" Margin="8,4,0,0"
                                           FontFamily="{StaticResource DeterminationFont}"
                                           FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                            <Button Grid.Column="2" Content="CONNECT"
                                    Style="{StaticResource PixelButton}"
                                    Click="BtnConnect_Click"/>
                        </Grid>
                        <CheckBox x:Name="ChkRememberIp" Content="[x] Remember IP address"
                                  Foreground="#A0A0A0" FontFamily="{StaticResource DeterminationFont}"
                                  FontSize="12" Margin="0,6,0,0" IsChecked="True"/>
                    </StackPanel>
                </StackPanel>

                <!-- === HOSTING SCREEN === -->
                <StackPanel x:Name="PanelHosting" Visibility="Collapsed">
                    <TextBlock Text="* Waiting for friend to connect..."
                               Style="{StaticResource PixelText}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtHostIpDisplay"
                               Style="{StaticResource PixelText}"
                               Foreground="#FFEB00"/>
                    <Button Content="COPY INVITE LINK" Style="{StaticResource PixelButton}"
                            Margin="0,10,0,0" Click="BtnCopyLink_Click"/>
                    <Button Content="[?] JOIN ZEROTIER NETWORK..."
                            Style="{StaticResource PixelButton}"
                            Margin="0,8,0,0" Click="BtnJoinZeroTier_Click"/>
                </StackPanel>

                <!-- === CONNECTED SCREEN === -->
                <StackPanel x:Name="PanelConnected" Visibility="Collapsed">
                    <TextBlock Text="* Connected!" Style="{StaticResource PixelText}"
                               Foreground="#00FF60" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtLatency" Style="{StaticResource PixelTextSmall}"
                               Margin="0,0,0,10"/>
                    <Button x:Name="BtnLaunch" Content="♥  LAUNCH GAME"
                            Style="{StaticResource PixelButton}"
                            Margin="0,0,0,8" Click="BtnLaunch_Click"/>
                    <Button Content="RESTORE SAVE..." Style="{StaticResource PixelButton}"
                            Click="BtnRestore_Click"/>
                </StackPanel>

                <!-- === DISCONNECT OVERLAY === -->
                <Border x:Name="OverlayDisconnect" Visibility="Collapsed"
                        Background="#E6000000" CornerRadius="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <TextBlock Text="* CONNECTION FAILED"
                                   Style="{StaticResource PixelText}"
                                   Foreground="#FF3040" HorizontalAlignment="Center"/>
                        <TextBlock Text="* GAME FROZEN FOR SAFETY"
                                   Style="{StaticResource PixelText}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtDisconnectTarget"
                                   Style="{StaticResource PixelTextSmall}"
                                   Foreground="#FFDE00"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TxtDisconnectReason"
                                   Style="{StaticResource PixelTextSmall}"
                                   Foreground="#FF8080"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtReconnecting"
                                   Style="{StaticResource PixelTextSmall}"
                                   Foreground="#A0A0A0"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <Button x:Name="BtnCancelReconnect" Content="CANCEL / RETURN"
                                Style="{StaticResource PixelButton}"
                                Margin="0,8,0,0" HorizontalAlignment="Center"
                                Click="BtnCancelReconnect_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status bar & Live Log Toggle -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatus"
                           Style="{StaticResource PixelTextSmall}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" x:Name="BtnDisconnectReturn" Content="[DISCONNECT]"
                        Style="{StaticResource PixelButton}" Margin="8,0,0,0"
                        Foreground="#FF8080" BorderBrush="#FF8080"
                        Click="BtnDisconnectReturn_Click" Visibility="Collapsed"/>
                <Button Grid.Column="2" x:Name="BtnToggleLogs" Content="[▼ LOGS]"
                        Style="{StaticResource PixelButton}" Margin="8,0,0,0"
                        Click="BtnToggleLogs_Click"/>
            </Grid>

            <!-- Collapsible Live Log Console -->
            <Border Grid.Row="1" x:Name="PanelLogConsole" Visibility="Collapsed"
                    Background="#050505" BorderBrush="#303030" BorderThickness="1"
                    CornerRadius="2" Margin="0,8,0,0" Height="150">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLiveLogs" IsReadOnly="True"
                                 Background="Transparent" Foreground="#A0FF80"
                                 BorderThickness="0" FontFamily="Consolas, Courier New, monospace"
                                 FontSize="11" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="OPEN FOLDER" Style="{StaticResource PixelButton}"
                                Margin="0,0,6,0" Click="BtnOpenLogFolder_Click"/>
                        <Button Content="COPY" Style="{StaticResource PixelButton}"
                                Margin="0,0,6,0" Click="BtnCopyLogs_Click"/>
                        <Button Content="CLEAR" Style="{StaticResource PixelButton}"
                                Click="BtnClearLogs_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
